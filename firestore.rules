rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminRecord() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasRole(role) {
      return hasAdminRecord()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == role;
    }

    function canManageProducts() {
      return hasRole('super_admin') || hasRole('catalogue_manager');
    }

    function canManageOrders() {
      return hasRole('super_admin') || hasRole('order_manager');
    }

    function canManageQuotations() {
      return hasRole('super_admin') || hasRole('sales_manager');
    }

    function isAdmin() {
      return hasAdminRecord();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: verified administrators only; writes blocked on client (managed via server/Admin SDK)
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin()) && isValidId(adminId);
      allow list: if hasRole('super_admin');
      allow write: if false;
    }

    // Products: public storefront read, verified admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if canManageProducts() && isValidId(productId);
    }

    // Categories: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if canManageProducts() && isValidId(categoryId);
    }

    // Guest checkout is currently local-only. A future server endpoint must
    // validate catalog prices and totals before it writes orders to Firestore.
    match /orders/{orderId} {
      allow create: if (hasRole('super_admin') || hasRole('sales_manager'))
        && isValidId(orderId)
        && request.resource.data.id == orderId
        && request.resource.data.fromQuotationId is string
        && request.resource.data.status == 'confirmed'
        && request.resource.data.paymentStatus == 'unpaid';
      allow read, update, delete: if canManageOrders() && isValidId(orderId);
    }

    // Public B2B submission must use a server endpoint with field validation.
    match /quotations/{quotationId} {
      allow create: if false;
      allow read, update, delete: if canManageQuotations() && isValidId(quotationId);
    }

    // Settings can contain operational or payment configuration.
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin') && isValidId(settingId);
    }

    // Audit entries are immutable for clients.
    match /audit_logs/{logId} {
      allow read: if isAdmin() && isValidId(logId);
      allow create: if (hasRole('super_admin')
          || hasRole('catalogue_manager')
          || hasRole('order_manager')
          || hasRole('sales_manager'))
        && isValidId(logId);
    }
  }
}
